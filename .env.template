# Copia este archivo como .env y completa los valores. El .env no se sube a git.
# Las variables de entorno reales tienen prioridad sobre este archivo,
# y lo guardado en la ventana de Configuración tiene prioridad sobre ambos.

# API key de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Valores por defecto opcionales
TRANSCRIPTOR_MODEL=gpt-transcribe
TRANSCRIPTOR_LANGUAGE=es
TRANSCRIPTOR_OUTPUT_FORMAT=docx
# Vacío = misma carpeta que el video
TRANSCRIPTOR_OUTPUT_DIR=
# Modelo que revisa el texto con el contexto (opción «Revisar el texto con IA»)
TRANSCRIPTOR_CORRECTION_MODEL=gpt-5.4-mini
